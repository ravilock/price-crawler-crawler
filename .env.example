# Local-only settings. Copy to .env; never commit credentials.
# Passwords in URLs must use URL-safe characters (or percent-encoding).
COMPOSE_PROJECT_NAME=price-crawler-local
GHCR_OWNER=ravilock
APP_PORT=19080
RABBITMQ_PORT=19072
RABBITMQ_MANAGEMENT_PORT=19073
RABBITMQ_DEFAULT_USER=price
RABBITMQ_DEFAULT_PASS=replace-with-local-password
POSTGRES_PORT=19032
POSTGRES_PASSWORD=replace-with-local-password
KEYCLOAK_PORT=19081
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-password
OIDC_BASE_URL=http://localhost:19081
USER_API_PORT=19082
READINESS_TIMEOUT_SECONDS=120
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=30
WORKER_CONCURRENCY=4
DATA_FINDER_IMAGE_TAG=cbb9e1088a36055d9812d28e07dc0083d000cae8
RENDERER_PARSER_IMAGE_TAG=ddaf34498116770221c311bc96df249c3d036beb
USER_API_IMAGE_TAG=9f11c648a2e9059599ed8e5af3d7b00efb10299e
MIGRATION_TIMEOUT_SECONDS=120

# Controlled source profile: set MOCK_CONTROL_TOKEN externally.
MOCK_STORE_IMAGE_TAG=6c1fbfc828ced8dc62ae5b570d607f4b007651f4
MOCK_SOURCE_PORT=19090
MOCK_CONTROL_PORT=19091

# Authenticated AMQP user allowed to publish crawl intents; empty disables consumption.
CRAWL_COMMAND_PUBLISHER=
RESULT_READ_PUBLISHER=

# Authenticated AMQP renderer identity; empty disables network fetch RPC.
NETWORK_FETCH_PUBLISHER=

# Authenticated AMQP finder identity; empty disables result consumption.
FINDER_RESULT_PUBLISHER=

# Authenticated AMQP renderer identity; empty disables rendered-result consumption.
RENDERER_RESULT_PUBLISHER=
