{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-admin.v1.schema.json",
  "title": "Source administration command and reply v1",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "message-envelope.v1.schema.json"
        },
        {
          "properties": {
            "message_type": {
              "const": "source.admin.command"
            },
            "payload": {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "object",
                  "properties": {
                    "subject": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "role": {
                      "enum": [
                        "administrator",
                        "manager",
                        "end_user",
                        "auditor",
                        "system"
                      ]
                    }
                  },
                  "required": [
                    "subject",
                    "role"
                  ],
                  "additionalProperties": false
                },
                "action": {
                  "enum": [
                    "inclusion.request",
                    "inclusion.review",
                    "robots.path_exception.create",
                    "source.read"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "domain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                "requested_categories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "decision": {
                  "enum": [
                    "approve",
                    "reject"
                  ]
                },
                "approved_categories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "access_rules_reviewed": {
                      "const": true
                    },
                    "terms_reviewed": {
                      "const": true
                    },
                    "supported_integration": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "request_pace_per_minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "access_rules_reviewed",
                    "terms_reviewed",
                    "supported_integration",
                    "request_pace_per_minute"
                  ],
                  "additionalProperties": false
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [
                "actor",
                "action"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "inclusion.request"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  },
                  "then": {
                    "required": [
                      "domain",
                      "requested_categories"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "inclusion.review"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_id",
                      "decision",
                      "review"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "robots.path_exception.create"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_id",
                      "path",
                      "reason"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "source.read"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_id"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "inclusion.review"
                      },
                      "decision": {
                        "const": "approve"
                      }
                    },
                    "required": [
                      "action",
                      "decision"
                    ]
                  },
                  "then": {
                    "required": [
                      "approved_categories"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "message-envelope.v1.schema.json"
        },
        {
          "properties": {
            "message_type": {
              "const": "source.admin.result"
            },
            "payload": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "pending",
                    "not_found",
                    "forbidden",
                    "invalid",
                    "conflict",
                    "expired",
                    "not_ready"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "state": {
                  "enum": [
                    "pending_review",
                    "approved",
                    "rejected",
                    "active",
                    "inactive"
                  ]
                },
                "approved_categories": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "minItems": 0,
                  "maxItems": 50,
                  "uniqueItems": true
                },
                "path_exception_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "audit_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                },
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "ok"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "anyOf": [
                      {
                        "required": [
                          "source_id",
                          "state"
                        ]
                      },
                      {
                        "required": [
                          "path_exception_id",
                          "audit_id"
                        ]
                      }
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "pending"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "required": [
                      "request_id"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "invalid",
                          "forbidden",
                          "not_found",
                          "conflict",
                          "expired",
                          "not_ready"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "required": [
                      "error"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
